{
    "name": "demo",
    "version": "1.0.0",
    "description": "",
    "main": "index.tsx",
    "repository": {
        "type": "git",
        "url": ""
    },
    "scripts": {
        "prettier-fix": "prettier --write \"*.{ts,tsx,js,jsx,json,css,scss,md}\" \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "lint": "oxlint --version && oxlint --disable-nested-config",
        "compile": "tsc --version && tsc --project tsconfig.json --noEmit --noErrorTruncation --pretty",
        "compile-watch": "tsc --project tsconfig.json --noEmit --watch --preserveWatchOutput",
        "start-dev-server": "webpack serve --env build=dev --env sourceMap=true",
        "clean-dist": "rm -rf dist",
        "build-prod": "npm run compile && npm run clean-dist && webpack --env build=prod --env sourceMap=false --env isServerBuild=true",
        "build-stg": "npm run compile && npm run clean-dist && webpack --env build=stg --env sourceMap=false --env isServerBuild=true",
        "build-dev": "npm run compile && npm run clean-dist && webpack --env build=dev --env sourceMap=false --env isServerBuild=true",
        "npm-check-outdated": "npm outdated",
        "check-peer-dependencies": "npx check-peer-dependencies --npm",
        "update-packages-semver-safe": "npm update",
        "update-packages-latest-available": "npx npm-check-updates -u",
        "install-packages": "npm install",
        "audit-fix-packages": "npm audit fix"
    },
    "author": "Jeramy Usher",
    "license": "ISC",
    "dependencies": {
        "@date-io/core": "^3.2.0",
        "@date-io/moment": "^3.2.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^9.0.0",
        "@mui/lab": "^9.0.0-beta.2",
        "@mui/material": "^9.0.0",
        "es6-promise": "^4.2.8",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@swc/core": "^1.16.21",
        "@types/jsdom": "^30.0.0",
        "@types/react": "^19.1.3",
        "@types/react-dom": "^19.1.3",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "autoprefixer": "^10.4.21",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.2",
        "eslint-plugin-jsdoc": "^65.0.0",
        "html-webpack-plugin": "^5.6.3",
        "jsdom": "^30.0.0",
        "mini-css-extract-plugin": "^2.9.2",
        "null-loader": "^4.0.1",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "postcss": "^8.5.3",
        "postcss-loader": "^8.1.1",
        "prettier": "^3.5.3",
        "sass": "^1.87.0",
        "sass-loader": "^17.0.0",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "swc-loader": "^0.2.7",
        "type-zoo": "^3.4.1",
        "typescript": "^7.0.2",
        "webpack": "^5.99.8",
        "webpack-bundle-analyzer": "^5.3.0",
        "webpack-cli": "^7.0.2",
        "webpack-dev-server": "^6.0.0"
    }
}
